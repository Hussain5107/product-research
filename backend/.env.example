# ProductHunter AI backend environment template
# Copy this file to .env and edit the values.

# Database
# Default local mode uses SQLite and does not require Docker.
POSTGRES_DSN=sqlite+aiosqlite:///./producthunter.db

# Optional PostgreSQL mode, if you later want Docker/PostgreSQL again:
# POSTGRES_DSN=postgresql+psycopg://producthunter:producthunter_local_dev_password@localhost:5433/producthunter

# Redis
REDIS_URL=redis://localhost:6379/0

# Application
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000

# AI provider configuration
# Supported providers: openai, anthropic, google, trism, or leave empty for no AI provider
AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini
AI_API_KEY=
AI_BASE_URL=

# Optional provider overrides
# ANTHROPIC_API_KEY=
# GOOGLE_AI_API_KEY=
# OPENAI_API_KEY=

# Common API credentials for external services
# Only add credentials you have legitimate access to.
# CJDROPSHIPPING_API_KEY=
# ZENDROP_API_KEY=
# SPOCKET_API_KEY=
# SYNCEE_API_KEY=
# GOOGLE_TRENDS_API_KEY=

# Web fetch and research settings
DEFAULT_REQUEST_TIMEOUT_SECONDS=30
MAX_CONCURRENT_REQUESTS=8
RESEARCH_JOB_TIMEOUT_SECONDS=600

# If the app is exposed beyond localhost, set a protection token here.
# Leave empty for local-only use.
API_ACCESS_TOKEN=
